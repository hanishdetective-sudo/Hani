function distance(a,b){ return Math.hypot(a.x-b.x, a.y-b.y); }
function wall(x,y){ const xx=Math.floor(x), yy=Math.floor(y); if(xx<0||yy<0||xx>=MAP_W||yy>=MAP_H) return true; return houseMap[yy][xx]==="#"; }
function canMove(x,y,r=.2){ return !wall(x-r,y-r)&&!wall(x+r,y-r)&&!wall(x-r,y+r)&&!wall(x+r,y+r); }
function moveObject(o,dx,dy,r=.2){ if(canMove(o.x+dx,o.y,r)) o.x+=dx; if(canMove(o.x,o.y+dy,r)) o.y+=dy; }
function normalizeAngle(a){ while(a>Math.PI*2) a-=Math.PI*2; while(a<0) a+=Math.PI*2; return a; }
function angleDifference(a,b){ const d=Math.abs(normalizeAngle(a)-normalizeAngle(b)); return Math.min(d,Math.PI*2-d); }

function randomOpenCell(minD=2, maxD=null){
  for(let i=0;i<300;i++){
    const x=Math.floor(Math.random()*(MAP_W-2))+1, y=Math.floor(Math.random()*(MAP_H-2))+1;
    if(!wall(x+.5,y+.5)){ const d=distance({x:x+.5,y:y+.5},game.player); if(d>=minD && (maxD===null||d<=maxD)) return {x:x+.5,y:y+.5}; }
  }
  return {x:2.5,y:2.5};
}
function openCellNear(tx,ty){
  let best=null,bd=Infinity;
  for(let x=1;x<MAP_W-1;x++) for(let y=1;y<MAP_H-1;y++){ if(wall(x+.5,y+.5)) continue; const d=Math.hypot(x+.5-tx,y+.5-ty); if(d<bd){bd=d;best={x:x+.5,y:y+.5};} }
  return best||randomOpenCell(1);
}
function clearLine(ax,ay,bx,by){ const d=Math.hypot(bx-ax,by-ay), n=Math.ceil(d*10); for(let i=1;i<n;i++){ const k=i/n; if(wall(ax+(bx-ax)*k, ay+(by-ay)*k)) return false; } return true; }
function spawnVisibleInFront(dist){          // a spot right in front of you with a clear line of sight (never behind a wall)
  const p=game.player;
  for(let dd=dist; dd>=1.8; dd-=0.4){
    for(const off of [0,0.22,-0.22,0.45,-0.45,0.7,-0.7]){
      const a=p.angle+off, x=p.x+Math.cos(a)*dd, y=p.y+Math.sin(a)*dd;
      if(wall(x,y) || !canMove(x,y,0.3)) continue;
      if(clearLine(p.x,p.y,x,y)) return {x:x,y:y};
    }
  }
  return null;                                // nowhere clear in front right now: caller waits until you face open space
}
function spawnInFrontOfPlayer(dist){ const p=game.player; return openCellNear(p.x+Math.cos(p.angle)*dist, p.y+Math.sin(p.angle)*dist); }

const ROOM_BOUNDS = [[1,3,1,3],[5,7,1,3],[9,11,1,3],[13,14,1,3],[1,3,8,9],[5,7,8,9],[9,11,8,9],[13,14,8,9]];
function addItem(type, p){
  const isPage = type==="page";
  const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: isPage?pageTex:bottleTex, transparent:true, alphaTest:0.05 }));
  sp.center.set(0.5,0); sp.position.set(p.x, 0.04, p.y);
  sp.scale.set(isPage?0.46:0.28, isPage?0.58:0.5, 1); scene.add(sp);
  game.items.push({ type, x:p.x, y:p.y, taken:false, sprite:sp, base:sp.scale.clone() });
}
function createItems(){
  game.items.forEach(it => { if(it.sprite) scene.remove(it.sprite); });
  game.items = []; const used = [];
  // pages: exactly one in each room, so every page (including the last one) has a guaranteed home
  for(let i=0;i<game.booksNeeded;i++){
    const b = ROOM_BOUNDS[i % ROOM_BOUNDS.length], cand = [];
    for(let x=b[0];x<=b[1];x++) for(let y=b[2];y<=b[3];y++){ const c={x:x+.5,y:y+.5}; if(distance(c,DOOR)>1.2) cand.push(c); }
    const p = cand[Math.floor(Math.random()*cand.length)];
    used.push(p); addItem("page", p);
  }
  // energy drinks: spread around the corridor and rooms
  for(let n=0;n<6;n++){
    for(let a=0;a<200;a++){
      const p = randomOpenCell(0.5);
      if(!used.some(q=>distance(q,p)<1.5) && distance(p,DOOR)>1.2){ used.push(p); addItem("bottle", p); break; }
    }
  }
}

