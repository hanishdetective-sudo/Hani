<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SLENDRIANA - Collect the Pages</title>
<style>
*{ box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
:root{ --bg:#020204; --panel:rgba(5,5,8,.72); --border:rgba(255,255,255,.15); --text:#f0f0f0; }
html,body{ width:100%; height:100%; overflow:hidden; background:var(--bg); color:var(--text); font-family:Arial,Helvetica,sans-serif; touch-action:none; }
canvas{ display:block; }
#gameWrap{ position:fixed; inset:0; }
#game{ width:100%; height:100%; cursor:crosshair; }
#gameWrap.shake{ animation:shakeAnim 0.45s ease-in-out; }
@keyframes shakeAnim{
  0%{transform:translate(0,0) rotate(0)} 10%{transform:translate(-10px,6px) rotate(-1deg)} 20%{transform:translate(9px,-7px) rotate(1deg)}
  30%{transform:translate(-8px,8px) rotate(-1deg)} 40%{transform:translate(10px,-5px) rotate(1deg)} 50%{transform:translate(-9px,6px) rotate(-1deg)}
  60%{transform:translate(7px,-8px) rotate(1deg)} 70%{transform:translate(-6px,5px) rotate(-1deg)} 80%{transform:translate(5px,-4px) rotate(1deg)}
  90%{transform:translate(-3px,3px) rotate(0)} 100%{transform:translate(0,0) rotate(0)}
}
#hud{ position:fixed; left:0; top:0; width:100%; height:100%; pointer-events:none; z-index:5; padding-top:env(safe-area-inset-top,0px); }
#topHUD{ display:flex; justify-content:space-between; padding:16px 18px; }
.panel{ background:var(--panel); border:1px solid var(--border); border-radius:10px; padding:9px 14px; box-shadow:0 0 20px rgba(0,0,0,.5); }
#books{ letter-spacing:1px; color:#d9c98a; font-size:16px; font-weight:bold; }
#item{ margin-top:6px; color:#ddd; font-size:12px; }
#energyTitle{ font-size:11px; color:#aaa; text-align:right; }
#energyBox{ width:190px; height:13px; margin-top:5px; border:1px solid #777; background:#090909; border-radius:20px; overflow:hidden; }
#energy{ width:100%; height:100%; background:#7ed957; transition:width .15s, background .3s; }
#energyNumber{ text-align:right; margin-top:3px; font-size:11px; }
#catches{ text-align:right; margin-top:5px; font-size:11px; color:#d38a8a; }
#crosshair{ position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); font-size:22px; font-weight:bold; color:rgba(255,255,255,.7); pointer-events:none; z-index:6; text-shadow:0 0 6px rgba(0,0,0,.8); }
#message{ position:fixed; left:50%; top:16%; transform:translateX(-50%); padding:12px 22px; background:rgba(0,0,0,.8); border:1px solid rgba(255,255,255,.18); border-radius:8px; font-weight:bold; opacity:0; transition:opacity .25s; z-index:8; letter-spacing:1px; text-align:center; max-width:80vw; }
#danger{ position:fixed; inset:0; pointer-events:none; border:0 solid rgba(170,0,0,.8); z-index:4; transition:border-width .2s; }
#bloodOverlay{
  position:fixed; inset:0; pointer-events:none; z-index:9; opacity:0; transition:opacity .4s;
  background:
    radial-gradient(ellipse 260px 180px at 4% 8%, rgba(120,0,0,0.85), rgba(120,0,0,0) 70%),
    radial-gradient(ellipse 220px 300px at 98% 4%, rgba(110,0,0,0.8), rgba(110,0,0,0) 70%),
    radial-gradient(ellipse 300px 220px at 0% 100%, rgba(130,0,0,0.85), rgba(130,0,0,0) 70%),
    radial-gradient(ellipse 240px 260px at 100% 96%, rgba(110,0,0,0.8), rgba(110,0,0,0) 70%),
    radial-gradient(ellipse 500px 340px at 50% 118%, rgba(90,0,0,0.7), rgba(90,0,0,0) 70%),
    radial-gradient(circle 8px at 22% 30%, rgba(160,10,10,0.9), rgba(160,10,10,0) 75%),
    radial-gradient(circle 6px at 68% 22%, rgba(160,10,10,0.85), rgba(160,10,10,0) 75%),
    radial-gradient(circle 10px at 80% 62%, rgba(160,10,10,0.9), rgba(160,10,10,0) 75%),
    radial-gradient(circle 7px at 30% 74%, rgba(160,10,10,0.85), rgba(160,10,10,0) 75%);
}
#map{ position:fixed; right:calc(16px + env(safe-area-inset-right,0px)); bottom:calc(16px + env(safe-area-inset-bottom,0px)); width:130px; height:98px; background:rgba(0,0,0,.72); border:1px solid rgba(255,255,255,.2); border-radius:8px; z-index:6; }
#fullMapOverlay{ position:fixed; inset:0; z-index:15; display:none; align-items:center; justify-content:center; background:rgba(0,0,0,.85); }
#fullMap{ background:rgba(10,10,14,.95); border:1px solid rgba(255,255,255,.25); border-radius:10px; }
#touchControls{ position:fixed; inset:0; z-index:7; display:none; }
#touchControls.active{ display:block; }
#lookZone{ position:absolute; right:0; top:0; width:60%; height:100%; pointer-events:auto; }
.joyBase{ position:absolute; left:calc(24px + env(safe-area-inset-left,0px)); bottom:calc(30px + env(safe-area-inset-bottom,0px)); width:110px; height:110px; border-radius:50%; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.25); pointer-events:auto; touch-action:none; }
.joyKnob{ position:absolute; left:50%; top:50%; width:46px; height:46px; margin:-23px 0 0 -23px; border-radius:50%; background:rgba(255,255,255,.28); border:1px solid rgba(255,255,255,.4); }
.touchBtn{ position:absolute; width:62px; height:62px; border-radius:50%; background:rgba(120,20,20,.35); border:1px solid rgba(255,255,255,.3); color:#fff; font-size:12px; font-weight:bold; display:flex; align-items:center; justify-content:center; pointer-events:auto; text-align:center; user-select:none; }
.touchBtn:active{ background:rgba(180,30,30,.55); }
#btnInteract{ right:calc(26px + env(safe-area-inset-right,0px)); bottom:calc(110px + env(safe-area-inset-bottom,0px)); width:72px; height:72px; font-size:13px; }
#btnSprint{ right:calc(110px + env(safe-area-inset-right,0px)); bottom:calc(30px + env(safe-area-inset-bottom,0px)); }
#btnCrouch{ right:calc(190px + env(safe-area-inset-right,0px)); bottom:calc(30px + env(safe-area-inset-bottom,0px)); }
#btnFlash{ right:calc(26px + env(safe-area-inset-right,0px)); bottom:calc(200px + env(safe-area-inset-bottom,0px)); width:52px; height:52px; font-size:11px; }
#btnMap{ right:calc(90px + env(safe-area-inset-right,0px)); bottom:calc(200px + env(safe-area-inset-bottom,0px)); width:52px; height:52px; font-size:11px; }
.screen{ position:fixed; inset:0; display:flex; justify-content:center; align-items:center; background:radial-gradient(circle at center,rgba(45,0,0,.22),rgba(0,0,0,.97) 70%); z-index:20; overflow-y:auto; }
.card{ width:min(760px,92vw); padding:32px; text-align:center; border:1px solid rgba(255,255,255,.18); border-radius:18px; background:linear-gradient(145deg,rgba(28,28,32,.96),rgba(5,5,8,.98)); box-shadow:0 0 60px rgba(0,0,0,.9), inset 0 0 40px rgba(255,255,255,.025); margin:20px 0; }
.logo{ font-size:46px; letter-spacing:8px; color:#eee; text-shadow:0 0 10px #fff, 0 0 35px rgba(160,0,0,.8); }
.subtitle{ color:#999; letter-spacing:4px; margin-top:8px; font-size:12px; }
.description{ margin:18px auto; max-width:600px; color:#bbb; line-height:1.6; font-size:14px; }
.previewWrap{ position:relative; height:160px; display:flex; align-items:flex-end; justify-content:center; margin:6px auto 0; overflow:hidden; }
.previewGlow{ position:absolute; bottom:0; width:220px; height:140px; background:radial-gradient(ellipse at center, rgba(120,0,0,.35), rgba(0,0,0,0) 70%); }
#slendrianaPreview{ height:160px; filter:brightness(0.9) drop-shadow(0 0 18px rgba(150,0,0,.5)); animation:sway 3.2s ease-in-out infinite, peer 5s ease-in-out infinite; transform-origin:bottom center; }
@keyframes sway{ 0%,100%{ transform:translateX(-6px) rotate(-1.5deg); } 50%{ transform:translateX(6px) rotate(1.5deg); } }
@keyframes peer{ 0%,40%{ filter:brightness(0.85) drop-shadow(0 0 14px rgba(150,0,0,.4)); } 50%{ filter:brightness(1.25) drop-shadow(0 0 30px rgba(200,20,20,.85)); } 60%,100%{ filter:brightness(0.85) drop-shadow(0 0 14px rgba(150,0,0,.4)); } }
.diffRow{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin:14px 0 6px; }
.diffBtn{ padding:11px 18px; border-radius:8px; border:1px solid #666; background:#141418; color:#ddd; font-weight:bold; cursor:pointer; letter-spacing:1px; transition:.2s; font-size:13px; }
.diffBtn:hover{ background:#26262c; }
.diffBtn.active{ background:linear-gradient(#5a1414,#280707); border-color:#b04444; color:#fff; }
#diffWarning{ min-height:50px; max-width:560px; margin:6px auto 10px; color:#cfa; font-size:12.5px; line-height:1.5; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.08); border-radius:8px; padding:9px 14px; }
button{ padding:13px 26px; border-radius:8px; border:1px solid #777; background:#16161a; color:white; font-size:14px; font-weight:bold; cursor:pointer; transition:.2s; margin:4px; }
button:hover{ background:#333; transform:translateY(-1px); }
.primary{ background:linear-gradient(#681515,#300707); border-color:#9a3a3a; }
.primary:hover{ background:linear-gradient(#8b1c1c,#430909); }
.note{ margin-top:14px; color:#666; font-size:11px; }
#pauseScreen, #endScreen{ display:none; }
@media(max-width:650px){ .logo{font-size:30px;letter-spacing:4px;} .card{padding:18px;} #map{display:none;} .previewWrap{height:110px;} #slendrianaPreview{height:110px;} }

#startScreen{ background:#03040a; overflow:hidden; display:flex; align-items:stretch; justify-content:flex-start; }
.tsLayer{ position:absolute; pointer-events:none; }
.tsSky{ inset:0; background:linear-gradient(#010208 0%, #070a16 48%, #1c1013 100%); }
.tsStars{ inset:0; opacity:.85; background:
  radial-gradient(1.4px 1.4px at 8% 12%,#fff,transparent), radial-gradient(1px 1px at 22% 6%,#dde,transparent), radial-gradient(1.6px 1.6px at 35% 20%,#fff,transparent),
  radial-gradient(1px 1px at 47% 9%,#ccd,transparent), radial-gradient(1.3px 1.3px at 58% 17%,#fff,transparent), radial-gradient(1px 1px at 71% 7%,#dde,transparent),
  radial-gradient(1.5px 1.5px at 83% 14%,#fff,transparent), radial-gradient(1px 1px at 92% 24%,#ccd,transparent), radial-gradient(1px 1px at 15% 31%,#bbc,transparent),
  radial-gradient(1.2px 1.2px at 64% 33%,#fff,transparent), radial-gradient(1px 1px at 41% 36%,#bbc,transparent), radial-gradient(1.2px 1.2px at 96% 5%,#fff,transparent); }
.tsMoon{ left:12%; top:9%; width:84px; height:84px; border-radius:50%; background:radial-gradient(circle at 35% 35%,#f3f0e2,#b9b5a2 62%,#7f7c6c); box-shadow:0 0 50px 18px rgba(190,200,235,.17); opacity:.82; }
.tsHouse{ left:0; bottom:0; width:100%; height:80vh; }
.winGlow{ animation:winFlick 3.1s infinite; } .winGlow2{ animation:winFlick 4.7s infinite .6s; } .eyeGlow{ animation:eyePulse 2.4s ease-in-out infinite; } .doorGlow{ animation:eyePulse 3.3s ease-in-out infinite; }
@keyframes winFlick{ 0%,100%{opacity:.5} 8%{opacity:.18} 12%{opacity:.6} 40%{opacity:.42} 44%{opacity:.08} 48%{opacity:.55} 75%{opacity:.5} }
@keyframes eyePulse{ 0%,100%{opacity:.35} 50%{opacity:.95} }
.tsFog{ left:-50%; width:200%; bottom:0; height:38%; animation:fogMove 55s linear infinite; }
.tsFog1{ background:radial-gradient(ellipse at 25% 100%,rgba(165,170,200,.20),transparent 60%), radial-gradient(ellipse at 72% 100%,rgba(150,155,185,.16),transparent 55%); z-index:2; }
.tsFog2{ height:26%; background:radial-gradient(ellipse at 40% 100%,rgba(170,175,205,.22),transparent 62%), radial-gradient(ellipse at 85% 100%,rgba(150,155,185,.18),transparent 58%); animation-duration:38s; animation-direction:reverse; z-index:4; }
@keyframes fogMove{ from{ transform:translateX(0) } to{ transform:translateX(-25%) } }
.titleSlen{ position:absolute; right:6vw; bottom:-3vh; height:96vh; max-width:92vw; object-fit:contain; z-index:3; transform-origin:bottom center; animation:slenSway 4.6s ease-in-out infinite; filter:drop-shadow(0 0 26px rgba(170,0,0,.65)); }
@keyframes slenSway{ 0%,100%{ transform:translateX(-5px) rotate(-.9deg) } 50%{ transform:translateX(6px) rotate(1deg) } }
.tsBloodTop{ left:0; right:0; top:0; height:34px; z-index:5; background:radial-gradient(circle 15px at 15px 0,#7a0000 97%,transparent) 0 0/40px 34px repeat-x, linear-gradient(#5e0000,#7a0000 0,#7a0000) 0 0/100% 10px no-repeat; }
.tsDrips{ inset:0; z-index:5; }
.drip{ position:absolute; top:0; height:0; background:linear-gradient(#8a0000,#4a0000); border-radius:0 0 10px 10px; animation:dripAnim 9s ease-in infinite; }
@keyframes dripAnim{ 0%{height:0;opacity:1} 45%{height:var(--len);opacity:1} 88%{height:var(--len);opacity:1} 100%{height:var(--len);opacity:0} }
.tsVignette{ inset:0; z-index:5; background:radial-gradient(ellipse at 60% 55%,transparent 38%,rgba(55,0,0,.55) 78%,rgba(20,0,0,.85) 100%); }
.tsFlicker{ inset:0; z-index:5; background:#000; opacity:0; animation:sceneFlick 8s infinite; }
@keyframes sceneFlick{ 0%,86%,100%{opacity:0} 87%{opacity:.55} 88%{opacity:.05} 89%{opacity:.6} 91%{opacity:0} }
.titleUI{ position:absolute; z-index:6; left:6vw; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; align-items:flex-start; gap:14px; }
.bigLogo{ font-family:"Palatino Linotype",Georgia,serif; font-weight:900; font-size:clamp(42px,8.2vw,118px); letter-spacing:.06em; color:#b00000; text-shadow:0 0 14px #5a0000, 0 5px 0 #2a0000, 0 0 40px rgba(150,0,0,.55); line-height:1; }
.bigLogo::after{ content:""; display:block; height:30px; background:radial-gradient(ellipse 5px 24px at 14px 0,#8a0000 58%,transparent 62%) 0 0/46px 30px repeat-x; opacity:.9; }
.tagline{ color:#9a8d80; letter-spacing:.42em; font-size:clamp(11px,1.5vw,15px); margin:2px 0 18px; text-shadow:0 0 8px #000; }
.menuBtn{ min-width:min(300px,70vw); padding:16px 40px; font-size:clamp(15px,2vw,20px); letter-spacing:.3em; color:#d8c9b0; background:linear-gradient(#2b1a10,#120a06); border:1px solid #5a3a22; border-radius:4px; box-shadow:0 0 0 1px #000, inset 0 0 22px rgba(0,0,0,.7); text-align:center; margin:0; }
.menuBtn:hover{ color:#fff; border-color:#a01818; background:linear-gradient(#3a1410,#1a0605); box-shadow:0 0 22px rgba(160,0,0,.55), inset 0 0 22px rgba(0,0,0,.6); transform:none; }
#playScreen,#quitScreen{ display:none; background:rgba(0,0,0,.8); z-index:21; }
.setRow{ display:flex; align-items:center; justify-content:space-between; gap:14px; max-width:420px; margin:12px auto; color:#bbb; font-size:13px; letter-spacing:2px; }
.setRow input[type=range]{ width:200px; accent-color:#9a3a3a; }
.setRow select{ background:#141418; color:#eee; border:1px solid #666; border-radius:6px; padding:6px 10px; font-size:12px; }
.setLabel{ margin-top:18px; color:#999; letter-spacing:4px; font-size:12px; }
.diffBtn[data-diff=extreme].active{ background:linear-gradient(#8a0000,#2a0000); border-color:#ff4040; }
.diffBtn[data-diff=practise].active{ background:linear-gradient(#1f4a2a,#0b200f); border-color:#5ec878; }
@media(max-width:700px){ .titleSlen{ right:-14vw; height:80vh; opacity:.9; } .titleUI{ left:5vw; top:42%; } }
</style>
</head>
