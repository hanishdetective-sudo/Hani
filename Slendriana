/* ===== Horror drone (procedural) ===== */
let audioCtx = null, droneNodes = null, droneActive = false;
function initAudio(){ if(audioCtx) return; try{ audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ audioCtx = null; } }
function startDrone(){
  if(!audioCtx || droneActive) return; droneActive = true;
  const t = audioCtx.currentTime, g = audioCtx.createGain();
  g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(0.24,t+0.35); g.connect(audioCtx.destination);
  const o1 = audioCtx.createOscillator(); o1.type="sine"; o1.frequency.value=64;
  const o2 = audioCtx.createOscillator(); o2.type="sine"; o2.frequency.value=68.5;
  const lfo = audioCtx.createOscillator(); lfo.frequency.value=5.5;
  const lg = audioCtx.createGain(); lg.gain.value=0.06; lfo.connect(lg); lg.connect(g.gain);
  o1.connect(g); o2.connect(g); o1.start(); o2.start(); lfo.start();
  droneNodes = {o1,o2,lfo,g};
}
function stopDrone(){
  if(!audioCtx || !droneActive || !droneNodes) return; droneActive = false;
  const t = audioCtx.currentTime, n = droneNodes;
  n.g.gain.cancelScheduledValues(t); n.g.gain.setValueAtTime(n.g.gain.value,t); n.g.gain.linearRampToValueAtTime(0.0001,t+0.5);
  setTimeout(()=>{ try{ n.o1.stop(); n.o2.stop(); n.lfo.stop(); }catch(e){} },600); droneNodes = null;
}

