(function bloodify(){
  const img = new Image();
  img.onload = () => {
    const w = img.width, h = img.height, c = document.createElement("canvas"); c.width = w; c.height = h;
    const x = c.getContext("2d"); x.drawImage(img, 0, 0); x.globalCompositeOperation = "source-atop";
    for(let i=0;i<10;i++){                                   // large dark stains
      const sx = w*(0.22+Math.random()*0.56), sy = h*(0.22+Math.random()*0.72), r = 14+Math.random()*46;
      const g = x.createRadialGradient(sx,sy,1,sx,sy,r); g.addColorStop(0,"rgba(110,0,0,.78)"); g.addColorStop(1,"rgba(110,0,0,0)");
      x.fillStyle = g; x.beginPath(); x.arc(sx,sy,r,0,Math.PI*2); x.fill();
    }
    function streak(sx, sy, len, wd, a){                     // a dripping streak with a rounded end
      const g = x.createLinearGradient(0,sy,0,sy+len); g.addColorStop(0,`rgba(135,0,0,${a})`); g.addColorStop(1,`rgba(85,0,0,${a*0.55})`);
      x.fillStyle = g; x.beginPath(); x.moveTo(sx-wd/2,sy); x.lineTo(sx+wd/2,sy); x.lineTo(sx+wd*0.35,sy+len); x.lineTo(sx-wd*0.35,sy+len); x.closePath(); x.fill();
      x.beginPath(); x.arc(sx,sy+len,wd*0.45,0,Math.PI*2); x.fill();
    }
    for(let i=0;i<52;i++) streak(w*(0.18+Math.random()*0.64), h*(0.14+Math.random()*0.62), h*(0.04+Math.random()*0.24), 2+Math.random()*6, 0.85);
    streak(w*0.455, h*0.075, h*0.14, 5, 0.95); streak(w*0.545, h*0.075, h*0.17, 5, 0.95); streak(w*0.50, h*0.112, h*0.24, 7, 0.95);   // from the eyes and mouth
    for(let i=0;i<70;i++){ x.fillStyle = `rgba(120,0,0,${0.5+Math.random()*0.45})`; x.beginPath(); x.arc(w*Math.random(), h*(0.1+Math.random()*0.85), 1+Math.random()*4, 0, Math.PI*2); x.fill(); }
    document.getElementById("slendrianaPreview").src = c.toDataURL("image/png");
  };
  img.src = SLENDRIANA_DATA_URI;
})();
