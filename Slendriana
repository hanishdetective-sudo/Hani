let bobT = 0, camH = 1.6;
function updatePlayer(dt){
  const p=game.player;
  p.crouching = !!(key.ControlLeft||key.ControlRight||(isTouch&&touchState.crouch));
  let dx=0,dy=0;
  if(isTouch){
    dx=Math.cos(p.angle)*(-touchState.moveY)+Math.cos(p.angle-Math.PI/2)*touchState.moveX;
    dy=Math.sin(p.angle)*(-touchState.moveY)+Math.sin(p.angle-Math.PI/2)*touchState.moveX;
  } else {
    if(key.KeyW){dx+=Math.cos(p.angle);dy+=Math.sin(p.angle);} if(key.KeyS){dx-=Math.cos(p.angle);dy-=Math.sin(p.angle);}
    if(key.KeyA){dx+=Math.cos(p.angle-Math.PI/2);dy+=Math.sin(p.angle-Math.PI/2);} if(key.KeyD){dx+=Math.cos(p.angle+Math.PI/2);dy+=Math.sin(p.angle+Math.PI/2);}
  }
  const len=Math.hypot(dx,dy); let moving=false, speed=0;
  if(len>0 && !game.fullMapOpen){
    dx/=len; dy/=len; moving=true;
    const sprinting = isTouch?touchState.sprint:(key.ShiftLeft||key.ShiftRight);
    if(p.crouching) speed=1.25; else if(sprinting&&p.energy>5){ speed=3.2; p.energy-=dt*game.diff.sprintDrain; } else speed=2.05;
    if(p.energy<=25) speed*=.6;
    moveObject(p,dx*speed*dt,dy*speed*dt,.2);
  }
  if(p.crouching) p.energy-=dt*game.diff.crouchDrain;
  p.energy-=dt*game.diff.passiveDrain;      // energy always drains slowly: you need drinks to survive
  p.energy=Math.max(0,Math.min(100,p.energy));
  if(p.energy<=0) loseDay("YOUR ENERGY REACHED ZERO");
  if(moving) bobT+=dt*speed*3.2;
  const targetH=p.crouching?0.95:1.6; camH+=(targetH-camH)*Math.min(1,dt*10);
  camera.position.set(p.x, camH+(moving?Math.sin(bobT)*0.035:0), p.y);
  camera.rotation.set(game.pitch, -p.angle-Math.PI/2, 0);
}

function updateHUD(){
  const p=game.player;
  document.getElementById("books").textContent="PAGES "+game.books+" / "+game.booksNeeded;
  document.getElementById("energyNumber").textContent=Math.ceil(p.energy)+"%";
  const e=document.getElementById("energy"); e.style.width=p.energy+"%"; e.style.background=p.energy<=25?"#d34a4a":"#7ed957";
  if(p.energy<30 && !game.lowWarned){ game.lowWarned=true; showMessage("LOW ENERGY — FIND AN ENERGY DRINK",2.5); }
  if(p.energy>=50) game.lowWarned=false;
  document.getElementById("bloodOverlay").style.opacity=(p.energy>=50?0:Math.min(1,(50-p.energy)/50))*0.9;
  const n=nearestItem(), el=document.getElementById("item");
  if(n) el.textContent=p.crouching?"CROUCHING":("PICK UP "+(n.type==="page"?"PAGE":"ENERGY DRINK"));
  else if(game.books>=game.booksNeeded && distance(p,DOOR)<3) el.textContent="OPEN THE WOODEN DOOR";
  else if(p.crouching) el.textContent="CROUCHING"; else el.textContent="FIND THE PAGES";
}

/* ---- per-frame 3D sync ---- */
let timeAcc = 0;
function syncScene(dt){
  timeAcc += dt;
  updateDoor(dt);
  const m=game.monster;
  monsterSprite.visible = m.active;
  if(m.active){
    monsterSprite.position.set(m.x, 0, m.y);
    monsterSprite.rotation.y = Math.atan2(camera.position.x - m.x, camera.position.z - m.y);
    const a=Math.min(1,m.alert); monsterMat.color.setRGB(1,1-0.35*a,1-0.35*a);
  }
  for(const it of game.items){ if(it.taken) continue; const s=1+Math.sin(timeAcc*3+it.x)*0.07; it.sprite.scale.set(it.base.x*s,it.base.y*s,1); }
  const near = m.active && distance(m,game.player)<6;
  const flick = near ? (0.6+Math.random()*0.4) : 1.0;
  if(lowMode){ const k = flick*(game.flashlight?1:0.5); for(const b of bakedMeshes) b.basic.color.setScalar(k); doorDim.forEach(mt=>mt.color.setScalar(0.62*k)); }
  else { flash.intensity = game.flashlight ? 1.3 : 0; ambient.intensity = flick; doorDim.forEach(mt=>mt.color.setScalar(0.62)); }
}

/* ---- 2D map overlays ---- */
function renderMinimap(){
  mctx.fillStyle="rgba(0,0,0,0.8)"; mctx.fillRect(0,0,130,98);
  const mw=130/MAP_W, mh=98/MAP_H;
  for(let y=0;y<MAP_H;y++) for(let x=0;x<MAP_W;x++) if(houseMap[y][x]==="#"){ mctx.fillStyle="#555"; mctx.fillRect(x*mw,y*mh,mw,mh); }
  const m=game.monster, p=game.player;
  if(m.active){ mctx.fillStyle="rgba(200,40,40,0.9)"; mctx.beginPath(); mctx.arc(m.x*mw,m.y*mh,3,0,Math.PI*2); mctx.fill(); }
  if(game.booksNeeded-game.books===1){ const lp=game.items.find(i=>i.type==="page"&&!i.taken); if(lp && Math.floor(performance.now()/400)%2===0){ mctx.fillStyle="#ffd84a"; mctx.fillRect(lp.x*mw-3,lp.y*mh-3,6,6); } }
  mctx.fillStyle="#7ed957"; mctx.beginPath(); mctx.arc(p.x*mw,p.y*mh,3,0,Math.PI*2); mctx.fill();
  mctx.strokeStyle="#7ed957"; mctx.lineWidth=1.5; mctx.beginPath(); mctx.moveTo(p.x*mw,p.y*mh); mctx.lineTo((p.x+Math.cos(p.angle)*.9)*mw,(p.y+Math.sin(p.angle)*.9)*mh); mctx.stroke();
}
function renderFullMap(){
  const cw=fullMapCanvas.width, ch=fullMapCanvas.height, sx=cw/MAP_W, sy=ch/MAP_H;
  fmctx.fillStyle="#0a0a0e"; fmctx.fillRect(0,0,cw,ch);
  for(let y=0;y<MAP_H;y++) for(let x=0;x<MAP_W;x++){ fmctx.fillStyle=houseMap[y][x]==="#"?"#3a3a42":"#151519"; fmctx.fillRect(x*sx,y*sy,sx-1,sy-1); }
  fmctx.fillStyle=game.books>=game.booksNeeded?"#7ed957":"#a07030"; fmctx.fillRect(DOOR.x*sx-5,DOOR.y*sy-9,10,18);
  for(const it of game.items){ if(it.taken) continue; fmctx.beginPath(); fmctx.fillStyle=it.type==="page"?"#dcc86e":"#78dc8c"; fmctx.arc(it.x*sx,it.y*sy,4,0,Math.PI*2); fmctx.fill(); }
  const m=game.monster, p=game.player;
  if(m.active){ fmctx.beginPath(); fmctx.fillStyle="#e03030"; fmctx.arc(m.x*sx,m.y*sy,5,0,Math.PI*2); fmctx.fill(); }
  fmctx.beginPath(); fmctx.fillStyle="#7ed957"; fmctx.arc(p.x*sx,p.y*sy,5,0,Math.PI*2); fmctx.fill();
}

/* ============================================================
   INPUT
   ============================================================ */
window.addEventListener("keydown", e => {
  key[e.code]=true;
  if(["KeyW","KeyA","KeyS","KeyD","ShiftLeft","ShiftRight","ControlLeft","ControlRight"].includes(e.code)) e.preventDefault();
  if(e.code==="Escape" && game.running && !game.paused){ if(document.pointerLockElement) document.exitPointerLock(); pauseGame(); }
  if(!game.running||game.paused) return;
  if(e.code==="KeyF") game.flashlight=!game.flashlight;
  if(e.code==="KeyE") interact();
  if(e.code==="KeyM") toggleFullMap();
});
window.addEventListener("keyup", e => { key[e.code]=false; });
canvas.addEventListener("click", () => {
  if(!game.running||game.paused||game.fullMapOpen) return;
  if(!document.pointerLockElement && canvas.requestPointerLock){
    try{ const r = canvas.requestPointerLock({ unadjustedMovement:true }); if(r && r.catch) r.catch(()=>{ canvas.requestPointerLock(); }); }
    catch(err){ canvas.requestPointerLock(); }
  }
});
document.getElementById("qualitySelect").value = ((navigator.hardwareConcurrency||2) >= 8) ? "normal" : "low";
let mouseSens = 0.0008*6 + 0.0008;
const sensSlider = document.getElementById("sensSlider");
sensSlider.addEventListener("input", () => { mouseSens = 0.0008*Number(sensSlider.value) + 0.0008; });
document.addEventListener("mousemove", e => {
  if(game.running && !game.paused && !game.fullMapOpen && document.pointerLockElement){
    const mx = e.movementX, my = e.movementY;
    if(Math.abs(mx) > 400 || Math.abs(my) > 400) return;          // ignore pointer-lock jump spikes
    game.player.angle += mx*mouseSens;
    game.pitch = Math.max(-1.2, Math.min(1.2, game.pitch - my*mouseSens*0.85));
    camera.rotation.set(game.pitch, -game.player.angle-Math.PI/2, 0);   // apply immediately: no waiting for next frame
  }
});

if(isTouch){
  document.getElementById("touchControls").classList.add("active");
  const joyBase=document.getElementById("joyBase"), joyKnob=document.getElementById("joyKnob");
  let joyId=null, jc={x:0,y:0};
  joyBase.addEventListener("touchstart", e=>{ e.preventDefault(); const t=e.changedTouches[0]; joyId=t.identifier; const r=joyBase.getBoundingClientRect(); jc={x:r.left+r.width/2,y:r.top+r.height/2}; });
  joyBase.addEventListener("touchmove", e=>{ e.preventDefault(); for(const t of e.changedTouches){ if(t.identifier!==joyId) continue;
    const dx=t.clientX-jc.x, dy=t.clientY-jc.y, d=Math.min(40,Math.hypot(dx,dy)), a=Math.atan2(dy,dx);
    joyKnob.style.left=(55+Math.cos(a)*d-23)+"px"; joyKnob.style.top=(55+Math.sin(a)*d-23)+"px";
    touchState.moveX=Math.cos(a)*(d/40); touchState.moveY=Math.sin(a)*(d/40); } });
  const joyEnd=e=>{ for(const t of e.changedTouches){ if(t.identifier===joyId){ joyId=null; touchState.moveX=0; touchState.moveY=0; joyKnob.style.left="50%"; joyKnob.style.top="50%"; } } };
  joyBase.addEventListener("touchend",joyEnd); joyBase.addEventListener("touchcancel",joyEnd);
  const lz=document.getElementById("lookZone"); let lookId=null, lx=0, ly=0;
  lz.addEventListener("touchstart", e=>{ e.preventDefault(); const t=e.changedTouches[0]; lookId=t.identifier; lx=t.clientX; ly=t.clientY; });
  lz.addEventListener("touchmove", e=>{ e.preventDefault(); for(const t of e.changedTouches){ if(t.identifier!==lookId) continue;
    game.player.angle+=(t.clientX-lx)*0.005; game.pitch=Math.max(-1.2,Math.min(1.2,game.pitch-(t.clientY-ly)*0.004)); lx=t.clientX; ly=t.clientY; } });
  const lookEnd=e=>{ for(const t of e.changedTouches){ if(t.identifier===lookId) lookId=null; } };
  lz.addEventListener("touchend",lookEnd); lz.addEventListener("touchcancel",lookEnd);
  const tap=(id,fn)=>document.getElementById(id).addEventListener("touchstart",e=>{ e.preventDefault(); fn(); });
  tap("btnInteract",interact); tap("btnFlash",()=>{ game.flashlight=!game.flashlight; }); tap("btnMap",toggleFullMap); tap("btnCrouch",()=>{ touchState.crouch=!touchState.crouch; });
  const sb=document.getElementById("btnSprint");
  sb.addEventListener("touchstart",e=>{ e.preventDefault(); touchState.sprint=true; }); sb.addEventListener("touchend",e=>{ e.preventDefault(); touchState.sprint=false; });
}

/* ============================================================
   MAIN LOOP
   ============================================================ */
let lastTime = performance.now(), hudAcc = 0, curRatio = DPR, frameAcc = 0, frameN = 0;
function loop(now){
  const dt = Math.min(0.1,(now-lastTime)/1000); lastTime = now;
  if(game.running && !game.paused){
    frameAcc += dt; frameN++;
    if(frameN >= 40){
      const avg = frameAcc/frameN; frameAcc = 0; frameN = 0;
      const slow = lowMode ? 0.036 : 0.022, minR = lowMode ? 0.4 : 0.5;
      if(avg > slow && curRatio > minR){ curRatio = Math.max(minR, curRatio*0.85); renderer.setPixelRatio(curRatio); renderer.setSize(W,H,false); }
    }
    if(!game.fullMapOpen){ updatePlayer(dt); updateMonster(dt); }
    syncScene(dt);
    hudAcc += dt; if(hudAcc > 0.1){ hudAcc = 0; updateHUD(); renderMinimap(); if(game.fullMapOpen) renderFullMap(); }
    renderer.render(scene,camera);
  }
  requestAnimationFrame(loop);
}
camera.position.set(2.5,1.6,2.5); camera.rotation.set(0,-Math.PI/2,0); renderer.render(scene,camera);
requestAnimationFrame(loop);
</script>
