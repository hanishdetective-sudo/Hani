function monsterCanSeePlayer(){
  const m=game.monster,p=game.player; if(!m.active||p.crouching) return false;
  const d=distance(m,p); if(d>game.diff.visionDist) return false;
  if(angleDifference(m.angle,Math.atan2(p.y-m.y,p.x-m.x))>1.05) return false;
  const steps=Math.ceil(d*12);
  for(let i=1;i<steps;i++){ const t=i/steps; if(wall(m.x+(p.x-m.x)*t,m.y+(p.y-m.y)*t)) return false; }
  return true;
}
function triggerCatch(){
  const pen = game.diff.catchPenalty;
  game.player.energy = Math.max(0, game.player.energy - pen);
  gameWrap.classList.remove("shake"); void gameWrap.offsetWidth; gameWrap.classList.add("shake");
  const dg=document.getElementById("danger"); dg.style.borderWidth="50px"; setTimeout(()=>{dg.style.borderWidth="0px";},350);
  const m=game.monster; m.catchCooldown=1.6; m.active=false; m.alert=0; stopDrone(); stopSlendrinaVoice();
  m.timer=game.diff.reappearMin+Math.random()*(game.diff.reappearMax-game.diff.reappearMin);
  showMessage("CAUGHT! ENERGY -"+pen+"%",1.6);
}
function updateMonster(dt){
  const m=game.monster,p=game.player; if(m.catchCooldown>0) m.catchCooldown-=dt;
  if(game.diff.noMonster) return;
  if(!m.active){
    m.timer-=dt;
    if(m.timer<=0){
      const want = game.diff.spawnDistance+1.5+Math.random()*1.5;
      let pos = spawnVisibleInFront(want);
      if(!pos){ m.spawnWait=(m.spawnWait||0)+dt; if(m.spawnWait>6) pos = spawnInFrontOfPlayer(want); }   // staring at a wall for 6s: spawn anyway
      if(pos){ m.spawnWait=0; m.x=pos.x; m.y=pos.y; m.angle=Math.atan2(p.y-pos.y,p.x-pos.x); m.active=true; m.freeze=1.8; showMessage("SHE'S HERE...",1.4); }
    }
    return;
  }
  const d=distance(m,p), sees=monsterCanSeePlayer();
  if(sees && !m.wasSeen) playSlendrinaVoice();
  if(sees) startDrone(); else stopDrone();
  m.wasSeen=sees; if(m.freeze>0) m.freeze-=dt;       // she stands still for a moment so you can clearly see her
  const dg=document.getElementById("danger");
  if(sees){ m.alert=Math.min(1,m.alert+dt*2); dg.style.borderWidth=Math.min(30,4+(10-Math.min(d,10))*2)+"px"; }
  else { m.alert=Math.max(0,m.alert-dt); if(m.catchCooldown<=0) dg.style.borderWidth="0px"; }
  if(!(m.freeze>0) && !p.crouching && (sees||(m.alert>.3&&d<8))){
    const dx=p.x-m.x,dy=p.y-m.y,len=Math.hypot(dx,dy)||1; m.angle=Math.atan2(dy,dx);
    const sp=0.9*game.diff.speedMult*(m.alert>.3?1.6:1); moveObject(m,dx/len*sp*dt,dy/len*sp*dt,.25);
  }
  if(d<.8 && !p.crouching && m.catchCooldown<=0 && !(m.freeze>0)){ triggerCatch(); return; }
  if(!sees){ m.reappearTimer-=dt; if(m.reappearTimer<=0){ m.active=false; m.timer=game.diff.spawnMin+Math.random()*(game.diff.spawnMax-game.diff.spawnMin); stopDrone(); } }
  else m.reappearTimer=game.diff.reappearMin+Math.random()*(game.diff.reappearMax-game.diff.reappearMin);
}
