/* ---- procedural textures ---- */
function makeCanvas(w,h){ const c = document.createElement("canvas"); c.width=w; c.height=h; return c; }
function speckle(ctx,w,h,n,alpha){ for(let i=0;i<n;i++){ const v = Math.random()<0.5?0:255; ctx.fillStyle=`rgba(${v},${v},${v},${Math.random()*alpha})`; ctx.fillRect(Math.random()*w,Math.random()*h,1+Math.random()*2,1+Math.random()*2); } }
function wallTexture(){
  const c = makeCanvas(128,384), x = c.getContext("2d");
  x.fillStyle="#bdb2a0"; x.fillRect(0,0,128,250); speckle(x,128,250,500,0.08);
  x.fillStyle="#2e1d12"; x.fillRect(0,250,128,12);                       // chair rail
  x.fillStyle="#4a3122"; x.fillRect(0,262,128,108);                      // wainscot
  for(let i=0;i<128;i+=32){ x.fillStyle="rgba(0,0,0,0.35)"; x.fillRect(i,270,2,92); x.fillStyle="rgba(255,220,170,0.08)"; x.fillRect(i+2,270,1,92); }
  x.fillStyle="#24160d"; x.fillRect(0,370,128,14);                       // baseboard
  const t = new THREE.CanvasTexture(c); t.anisotropy = 1; return t;
}
function curtainTexture(){
  const c = makeCanvas(128,384), x = c.getContext("2d");
  x.fillStyle="#1a2433"; x.fillRect(0,0,128,384);                        // night window behind
  for(let i=0;i<128;i++){ const s = 0.55+0.45*Math.sin(i*0.33); x.fillStyle=`rgb(${Math.floor(150*s)},${Math.floor(22*s)},${Math.floor(28*s)})`; x.fillRect(i,18,1,300); }
  x.fillStyle="#2b1a0e"; x.fillRect(0,0,128,16);                         // rod
  x.fillStyle="#bfa050"; x.fillRect(0,6,128,4);
  x.fillStyle="#24160d"; x.fillRect(0,370,128,14);
  const t = new THREE.CanvasTexture(c); t.anisotropy = 1; return t;
}
function floorTexture(){
  const c = makeCanvas(256,256), x = c.getContext("2d");
  for(let p=0;p<4;p++){ const l = 30+Math.random()*14; x.fillStyle=`hsl(26,38%,${l}%)`; x.fillRect(0,p*64,256,64);
    for(let g=0;g<40;g++){ x.fillStyle=`rgba(0,0,0,${Math.random()*0.12})`; x.fillRect(Math.random()*256,p*64+Math.random()*64,30+Math.random()*80,1); }
    x.fillStyle="rgba(0,0,0,0.55)"; x.fillRect(0,p*64,256,2); x.fillRect(((p*97)%200)+20,p*64,2,64); }
  const t = new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(8,6); t.anisotropy = 1; return t;
}
function ceilTexture(){
  const c = makeCanvas(128,128), x = c.getContext("2d");
  x.fillStyle="#2a1d14"; x.fillRect(0,0,128,128);
  for(let g=0;g<60;g++){ x.fillStyle=`rgba(0,0,0,${Math.random()*0.25})`; x.fillRect(0,Math.random()*128,128,1); }
  x.fillStyle="rgba(0,0,0,0.5)"; x.fillRect(0,0,128,2);
  const t = new THREE.CanvasTexture(c); t.wrapS=t.wrapT=THREE.RepeatWrapping; t.repeat.set(8,6); return t;
}
function spriteCanvasTexture(draw,w,h){ const c = makeCanvas(w,h); draw(c.getContext("2d"),w,h); return new THREE.CanvasTexture(c); }

/* ---- geometry: merged meshes + lamp light BAKED into vertex colors (very cheap to render) ---- */
const wallMat = new THREE.MeshLambertMaterial({ map: wallTexture(), vertexColors: true });
const curtainMat = new THREE.MeshLambertMaterial({ map: curtainTexture(), vertexColors: true });
const floorMat = new THREE.MeshLambertMaterial({ map: floorTexture(), vertexColors: true });
const ceilMat = new THREE.MeshLambertMaterial({ map: ceilTexture(), vertexColors: true });
function isWallCell(x,y){ return x<0||y<0||x>=MAP_W||y>=MAP_H || houseMap[y][x]==="#"; }

function bakedLight(px,py,pz,nx,ny,nz){
  let sum = 0;
  for(const L of LIGHTS){
    const lx=L.x, ly=WALL_H-0.35, lz=L.y;
    const dx=lx-px, dy=ly-py, dz=lz-pz, d=Math.hypot(dx,dy,dz);
    if(d>10) continue;
    let sx=px+nx*0.08, sz=pz+nz*0.08;                       // start just off the surface
    const pd=Math.hypot(lx-sx,lz-sz);
    if(pd>0.2){ sx+=(lx-sx)/pd*0.12; sz+=(lz-sz)/pd*0.12; }   // nudge toward the lamp (avoids seam artifacts)
    const steps=Math.max(1,Math.ceil(Math.hypot(lx-sx,lz-sz)/0.15));
    let blocked=false;
    for(let i=0;i<=steps;i++){ const k=i/steps; if(wall(sx+(lx-sx)*k, sz+(lz-sz)*k)){ blocked=true; break; } }
    if(blocked) continue;
    const lam=Math.max(0,(nx*dx+ny*dy+nz*dz)/d)*0.6+0.4;
    sum += lam*1.25/(1+Math.pow(d/3.0,2));
  }
  return sum;
}
function newStore(){ return {pos:[],nor:[],uv:[],col:[],idx:[]}; }
function collect(store, geo){
  const base=store.pos.length/3, p=geo.attributes.position, n=geo.attributes.normal, u=geo.attributes.uv;
  for(let i=0;i<p.count;i++){
    const px=p.getX(i),py=p.getY(i),pz=p.getZ(i),nx=n.getX(i),ny=n.getY(i),nz=n.getZ(i);
    store.pos.push(px,py,pz); store.nor.push(nx,ny,nz); store.uv.push(u.getX(i),u.getY(i));
    const s=bakedLight(px,py,pz,nx,ny,nz), a=0.2;
    store.col.push(Math.min(1.6,a*0.9+s*1.0), Math.min(1.6,a*0.95+s*0.82), Math.min(1.6,a*1.1+s*0.58));
  }
  const ix=geo.index.array; for(let i=0;i<ix.length;i++) store.idx.push(ix[i]+base);
}
function meshFrom(store, mat){
  const g=new THREE.BufferGeometry();
  g.setAttribute("position",new THREE.Float32BufferAttribute(store.pos,3));
  g.setAttribute("normal",new THREE.Float32BufferAttribute(store.nor,3));
  g.setAttribute("uv",new THREE.Float32BufferAttribute(store.uv,2));
  g.setAttribute("color",new THREE.Float32BufferAttribute(store.col,3));
  g.setIndex(store.idx); return new THREE.Mesh(g,mat);
}
const bakedMeshes = [];
function addBaked(store, lam){ const m=meshFrom(store,lam); scene.add(m); bakedMeshes.push({ mesh:m, lam:lam, basic:new THREE.MeshBasicMaterial({ map:lam.map, vertexColors:true }) }); }
const wallStore=newStore(), curtainStore=newStore();
for(let y=0;y<MAP_H;y++) for(let x=0;x<MAP_W;x++){
  if(houseMap[y][x] !== "#") continue;
  let touchesOpen=false;
  for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){ if(!isWallCell(x+dx,y+dy)){ touchesOpen=true; break; } }
  if(!touchesOpen) continue;
  const g=new THREE.BoxGeometry(1,WALL_H,1); g.translate(x+0.5,WALL_H/2,y+0.5);
  collect(CURTAIN_CELLS.has(x+","+y)?curtainStore:wallStore, g);
}
addBaked(wallStore,wallMat); addBaked(curtainStore,curtainMat);
const floorGeo=new THREE.PlaneGeometry(MAP_W,MAP_H,32,24); floorGeo.rotateX(-Math.PI/2); floorGeo.translate(MAP_W/2,0,MAP_H/2);
const floorStore=newStore(); collect(floorStore,floorGeo); addBaked(floorStore,floorMat);
const ceilGeo=new THREE.PlaneGeometry(MAP_W,MAP_H,16,12); ceilGeo.rotateX(Math.PI/2); ceilGeo.translate(MAP_W/2,WALL_H,MAP_H/2);
const ceilStore=newStore(); collect(ceilStore,ceilGeo); addBaked(ceilStore,ceilMat);
const beamMat = new THREE.MeshBasicMaterial({ color: 0x160d07 });
for(let bx=1; bx<MAP_W; bx+=2){ const b=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.28,MAP_H), beamMat); b.position.set(bx,WALL_H-0.14,MAP_H/2); scene.add(b); }

/* ---- lighting: lamps are baked above; only the flashlight is a live light ---- */
const ambient = new THREE.AmbientLight(0xffffff, 1.0); scene.add(ambient);
const lampMat = new THREE.MeshBasicMaterial({ color: 0xffe6b0 });
LIGHTS.forEach(L => { const lamp=new THREE.Mesh(new THREE.CylinderGeometry(0.28,0.28,0.05,8), lampMat); lamp.position.set(L.x,WALL_H-0.05,L.y); scene.add(lamp); });
const flash = new THREE.SpotLight(0xfff0d0, 1.3, 16, 0.5, 0.45, 1.4);
camera.add(flash); const flashTarget = new THREE.Object3D(); flashTarget.position.set(0,0,-1); camera.add(flashTarget); flash.target = flashTarget;

let lowMode = true;
function applyQuality(low){
  lowMode = low;
  for(const b of bakedMeshes) b.mesh.material = low ? b.basic : b.lam;   // LOW = no live lights at all
  flash.visible = !low;
  curRatio = low ? Math.min(DPR, 0.7) : DPR;
  renderer.setPixelRatio(curRatio); renderer.setSize(W, H, false);
}
/* ---- wooden exit door: panelled slab on a hinge, dark frame, brass handle, chains while locked, bright light when open ---- */
function doorSlabTexture(){
  const c = makeCanvas(256,512), x = c.getContext("2d");
  x.fillStyle="#4b2d18"; x.fillRect(0,0,256,512);
  for(let i=0;i<256;i+=32){ x.fillStyle="rgba(0,0,0,0.28)"; x.fillRect(i,0,2,512); x.fillStyle="rgba(255,220,160,0.05)"; x.fillRect(i+2,0,2,512); }
  for(let g=0;g<260;g++){ x.fillStyle=`rgba(${Math.random()<.5?0:60},${Math.random()<.5?0:30},0,${Math.random()*0.09})`; x.fillRect(Math.random()*256,Math.random()*512,1,12+Math.random()*60); }
  function panel(px,py,pw,ph){
    x.fillStyle="#2f1b0d"; x.fillRect(px,py,pw,ph);
    x.fillStyle="#62401f"; x.fillRect(px+9,py+9,pw-18,ph-18);
    x.fillStyle="rgba(255,225,170,0.22)"; x.fillRect(px+9,py+9,pw-18,4); x.fillRect(px+9,py+9,4,ph-18);
    x.fillStyle="rgba(0,0,0,0.5)"; x.fillRect(px+9,py+ph-13,pw-18,4); x.fillRect(px+pw-13,py+9,4,ph-18);
  }
  panel(24,26,100,176); panel(132,26,100,176); panel(24,224,100,262); panel(132,224,100,262);
  x.fillStyle="rgba(0,0,0,0.35)"; x.fillRect(0,0,256,6); x.fillRect(0,506,256,6);
